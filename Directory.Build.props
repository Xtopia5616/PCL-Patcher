<Project>

  <!-- Shared metadata for every project in this repository. -->
  <PropertyGroup>
    <Product>PCL Patcher</Product>
    <AssemblyTitle>PCL Patcher</AssemblyTitle>
    <Description>Plain Craft Launcher (PCL) IL patcher and net48 WPF GUI.</Description>
    <Company>Xtopia</Company>
    <Authors>Xtopia &amp; DeepSeek</Authors>
    <Copyright>© 2026 Xtopia</Copyright>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- NU1900 means the vulnerability feed could not be reached (offline build),
         not that the package audit failed. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
